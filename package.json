{
  "name": "agent-releases",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run dev:cloudflare",
    "check": "tsc --noEmit && bun run test && bun run selfcheck:draft && bun run check:cloudflare",
    "test": "bun test src",
    "selfcheck:draft": "bun run src/draft-selfcheck.ts",
    "smoke:llm": "bun run src/smoke-llm.ts",
    "check:cloudflare": "wrangler deploy --dry-run --outdir .worker-build && node --test tests/cloudflare.test.mjs",
    "dev:cloudflare": "wrangler dev --test-scheduled --var DRY_RUN:true",
    "export:d1": "bun run scripts/export-d1.ts"
  },
  "dependencies": {
    "twitter-api-v2": "^1.17.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260910.1",
    "@types/bun": "latest",
    "miniflare": "^5.20260908.0-alpha",
    "typescript": "^5.6.0",
    "wrangler": "^4.130.0"
  }
}
