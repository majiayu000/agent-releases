# Local start always previews. Live publication only runs through Actions reservations.
# X OAuth 1.0a (used only by the live publish job and account maintenance)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Required for drafting (Zhipu BigModel Anthropic-compatible); no fallback posts
# Default model: GLM-5.3-Flash
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# LLM draft (BigModel Anthropic-compatible)
DRAFT_MODEL=glm-5.3-flash
# DRAFT_TIMEOUT_MS=120000
# Explicit thinking is opt-in; omitted means the provider chooses its default.
# DRAFT_THINKING=on  # optional; omit by default (faster on Actions)
# DRAFT_REASONING_EFFORT=low
# Token exhaustion fails generation. Validate budget changes with smoke:llm before live use.
# DRAFT_MAX_TOKENS=32768
