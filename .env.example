# Hourly Action defaults to DRY_RUN=false (live X posting).
# Local default in code is DRY_RUN=true unless you set false.
DRY_RUN=true
# X OAuth 1.0a (required when DRY_RUN=false)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional LLM Chinese drafting (Zhipu BigModel Anthropic-compatible)
# Default model: GLM-5.3-Flash
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
# LLM draft (BigModel Anthropic-compatible)
DRAFT_MODEL=glm-5.3-flash
# DRAFT_TIMEOUT_MS=120000
# GLM-5.3-flash cannot disable thinking; default effort is max if omitted — we force low.
# DRAFT_THINKING=on  # optional; omit by default (faster on Actions)
# DRAFT_REASONING_EFFORT=low
# API requires max_tokens; high ceiling ≈ unrestricted for short posts (default 4096 (Actions-safe); raise via DRAFT_MAX_TOKENS if timeout allows)
# DRAFT_MAX_TOKENS=32768
